<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.chapter02.mapper.LegacyUserMapper">

    <select id="findAllByxml" resultType="com.example.entity.User">
        SELECT id, username, password, email, created_at, updated_at
        FROM `user`
        ORDER BY id
    </select>

    <select id="findByIdXML" parameterType="java.lang.Integer"
            resultType="com.example.entity.User">
        SELECT id, username, password, email, created_at, updated_at
        FROM `user`
        WHERE id = #{id}
    </select>

    <select id="findByNameAndPass" parameterType="com.example.entity.User"
            resultType="com.example.entity.User">
        SELECT id, username, password, email, created_at, updated_at
        FROM `user`
        WHERE username = #{username} OR password = #{password}
        ORDER BY id
    </select>

    <select id="findByUsernameXML" parameterType="java.lang.String"
            resultType="com.example.entity.User">
        SELECT id, username, password, email, created_at, updated_at
        FROM `user`
        WHERE username = #{_parameter}
    </select>

    <select id="findByMap" parameterType="map"
            resultType="com.example.entity.User">
        SELECT id, username, password, email, created_at, updated_at
        FROM `user`
        WHERE password = #{abc} OR username = #{username}
        ORDER BY id
    </select>

    <select id="findCount" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM `user`
    </select>

    <insert id="addUserxml" parameterType="com.example.entity.User"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `user` (username, password, email)
        VALUES (#{username}, #{password}, #{email})
    </insert>

    <insert id="addUser" parameterType="com.example.entity.User"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `user` (username, password, email)
        VALUES (#{username}, #{password}, #{email})
    </insert>

    <update id="updateUser" parameterType="com.example.entity.User">
        UPDATE `user`
        SET username = #{username}, password = #{password}, email = #{email}
        WHERE id = #{id}
    </update>

    <delete id="deleteUser" parameterType="java.lang.Integer">
        DELETE FROM `user` WHERE id = #{id}
    </delete>
</mapper>
